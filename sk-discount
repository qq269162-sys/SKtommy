    data = {
        "shares_hynix_held": SHARES_HYNIX_HELD,
        "shares_skq_issued": SHARES_SKQ_ISSUED,
        "k": round(K, 6),
        "other_assets_krw_fallback": OTHER_ASSETS_KRW_FALLBACK,
        "sources": {
            "prices": "Yahoo Finance chart API (000660.KS / 402340.KS)",
            "nav": NAV_URL,
            "shares": "DART/KRX 披露;SK Square IR",
        },
    }
    if args.json:
        print(json.dumps(data, ensure_ascii=False, indent=2))
        return
    print()
    print(f"  {f.bold('结构参数')}")
    print(f"  {'SK Q 持有海力士股数':<22} {SHARES_HYNIX_HELD:>15,}   {f.dim('DART/KRX,占海力士总股本 20.00%')}")
    print(f"  {'SK Q 自身总股本':<24} {SHARES_SKQ_ISSUED:>15,}   {f.dim('SK Square IR')}")
    print(f"  {'k = 前者 / 后者':<25} {K:>15.6f}   {f.dim('每股 SK Q 背后的海力士股数')}")
    fallback = f"₩{OTHER_ASSETS_KRW_FALLBACK / 1e12:.2f} 万亿"
    print(f"  {'非海力士资产(兜底)':<21} {fallback:>15}   {f.dim('--precise 时优先取官网实时值')}")
    print()
    print(f"  {f.bold('公式')}")
    print(f"    c = P_SKQ / (k × P_HYNIX)                      {f.dim('简化,仅海力士')}")
    print(f"    c = P_SKQ / (k × P_HYNIX + 其他资产/总股本)      {f.dim('--precise,全资产')}")
    print(f"    传统折价率 = 1 − c")
    print()
    print(f"  {f.bold('数据源')}")
    print(f"    {f.dim('价格')}  Yahoo Finance chart API(000660.KS / 402340.KS)")
    print(f"    {f.dim('NAV ')}  {NAV_URL}")
    print()


# --- 入口 -------------------------------------------------------------------
def build_parser():
    p = argparse.ArgumentParser(
        prog="sk-discount",
        description="SK스퀘어 相对其 SK하이닉스 持仓的折价追踪器。不带子命令时输出当前读数。",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="示例:\n"
               "  sk-discount                      当前折价\n"
               "  sk-discount --precise            计入非海力士资产\n"
               "  sk-discount --hynix 1857000 --skq 1079000\n"
               "  sk-discount history -p 6m --official\n"
               "  sk-discount history --csv > c.csv\n"
               "  sk-discount calibrate            校验内置持股数\n",
    )
    # 全局开关放在主解析器上给出默认值;子解析器上再挂一份同名开关,
    # 好让它们写在子命令之后也生效。子解析器那份必须 default=SUPPRESS,
    # 否则它的默认值会把主解析器已经设好的值覆盖掉。
    def add_global(q, primary):
        kw = {} if primary else {"default": argparse.SUPPRESS}
        q.add_argument("--json", action="store_true",
                       help="以 JSON 输出" if primary else argparse.SUPPRESS, **kw)
        q.add_argument("--no-color", action="store_true",
                       help="禁用彩色输出" if primary else argparse.SUPPRESS, **kw)

    def add_now(q, primary):
        kw = {} if primary else {"default": argparse.SUPPRESS}
        hide = (lambda t: t if primary else argparse.SUPPRESS)
        q.add_argument("--hynix", type=float, metavar="₩", help=hide("手动指定海力士股价"), **kw)
        q.add_argument("--skq", type=float, metavar="₩", help=hide("手动指定 SK Square 股价"), **kw)
        q.add_argument("--precise", action="store_true",
                       help=hide("计入非海力士资产(需联网取官网 NAV)"), **kw)

    add_global(p, True)
    add_now(p, True)
    sub = p.add_subparsers(dest="cmd")

    n = sub.add_parser("now", help="当前折价读数")
    add_now(n, False)
    add_global(n, False)

    h = sub.add_parser("history", help="历史序列 + 走势图")
    h.add_argument("-p", "--period", choices=list(PERIODS), default="3m", help="区间,默认 3m")
    h.add_argument("--official", action="store_true", help="附官网日频 NAV 折价做对照")
    h.add_argument("--tail", type=int, default=15, metavar="N", help="只显示最后 N 行,默认 15")
    h.add_argument("--all", action="store_true", help="显示全部行")
    h.add_argument("--csv", action="store_true", help="输出 CSV")
    add_global(h, False)

    c = sub.add_parser("calibrate", help="用官网 NAV 折价反解并校验内置持股数")
    c.add_argument("-p", "--period", choices=list(PERIODS), default="6m", help="标定区间,默认 6m")
    add_global(c, False)

    s = sub.add_parser("params", help="显示结构参数、公式与数据源")
    add_global(s, False)
    return p


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    color = sys.stdout.isatty() and not args.no_color and not os.environ.get("NO_COLOR")
    f = Fmt(color)
    handlers = {None: cmd_now, "now": cmd_now, "history": cmd_history,
                "calibrate": cmd_calibrate, "params": cmd_params}
    try:
        handlers[args.cmd](args, f)
    except DataError as e:
        print(f"sk-discount: {e}", file=sys.stderr)
        return 2
    except KeyboardInterrupt:
        return 130
    return 0


if __name__ == "__main__":
    sys.exit(main())
