    document.getElementById('barPay').style.width=Math.max(0,Math.min(100,c*100))+'%';
    document.getElementById('payAmt').textContent='\\u20a9'+(c*100).toFixed(1);
    document.getElementById('barNote').textContent=
      '\\u4ee5 \\u20a9100 \\u7684\\u6d77\\u529b\\u58eb\\u80a1\\u6743\\u4ef7\\u503c\\u4e3a\\u57fa\\u51c6 \\u2014 '+
      '\\u901a\\u8fc7 SK Square \\u95f4\\u63a5\\u6301\\u6709\\uff0c\\u5f53\\u524d\\u53ea\\u9700\\u4ed8 \\u20a9'+(c*100).toFixed(1)+'\\u3002';
  }
  hy.addEventListener('input',upd); sq.addEventListener('input',upd);
})();
</script>
</body>
</html>
"""


def _svg(view, W, H, ml, mr, mt, mb, fs, xticks):
    n = len(view)
    allc = [s["c"] for s in view] + [s["co"] for s in view if s["co"] is not None]
    y0 = math.floor(min(allc) * 20 - 0.5) / 20
    y1 = 1.0
    iw, ih = W - ml - mr, H - mt - mb

    def X(i):
        return round(ml + (iw / 2 if n == 1 else i * iw / (n - 1)), 1)

    def Y(v):
        return round(mt + ih - (v - y0) / (y1 - y0) * ih, 1)

    g = []
    v = math.ceil(y0 * 20) / 20
    while v <= y1 + 1e-9:
        yy, par = Y(v), abs(v - 1) < 1e-9
        g.append(f'<line class="{"par" if par else "grid"}" x1="{ml}" y1="{yy}" '
                 f'x2="{ml + iw}" y2="{yy}"/>')
        g.append(f'<text x="{ml - 7}" y="{yy + fs * 0.35:.0f}" text-anchor="end" '
                 f'font-size="{fs}">{v:.2f}</text>')
        v += 0.05
    g.append(f'<text class="par-t" x="{ml + iw}" y="{Y(1) - 6}" text-anchor="end" '
             f'font-size="{fs}">&#8361;1.00 &#183; 无折价</text>')

    step = max(1, n // xticks)
    for i in range(0, n, step):
        g.append(f'<text x="{X(i)}" y="{mt + ih + fs + 6}" text-anchor="middle" '
                 f'font-size="{fs}">{view[i]["d"][5:]}</text>')

    pts = " L ".join(f"{X(i)} {Y(s['c'])}" for i, s in enumerate(view))
    g.append(f'<path class="s1-area" d="M {ml} {mt + ih} L {pts} L {ml + iw} {mt + ih} Z"/>')

    seg, segs = [], []
    for i, s in enumerate(view):
        if s["co"] is not None:
            seg.append(f"{X(i)} {Y(s['co'])}")
        else:
            if len(seg) > 1:
                segs.append(seg)
            seg = []
    if len(seg) > 1:
        segs.append(seg)
    for sg in segs:
        g.append(f'<path class="s2-line" d="M {" L ".join(sg)}"/>')

    g.append(f'<path class="s1-line" d="M {pts}"/>')
    last = view[-1]
    lx, ly = X(n - 1), Y(last["c"])
    g.append(f'<circle class="dot" cx="{lx}" cy="{ly}" r="4.5"/>')
    g.append(f'<text class="val" x="{lx - 7}" y="{ly - 9}" text-anchor="end" '
             f'font-size="{fs + 2}">{last["c"]:.3f}</text>')
    return (f'<svg class="ch" viewBox="0 0 {W} {H}" role="img" '
            f'aria-label="成本系数 c 走势,最新 {last["c"]:.3f}">' + "".join(g) + "</svg>")


def _stats_row(view):
    cs = [s["c"] for s in view]
    lo = min(view, key=lambda s: s["c"])
    hi = max(view, key=lambda s: s["c"])
    pairs = [s for s in view if s["co"] is not None]
    mae = (statistics.mean(abs(s["c"] - s["co"]) for s in pairs)) if pairs else None
    return (
        '<div class="chart-foot">'
        f'<span>{view[0]["d"]} → {view[-1]["d"]} · {len(view)} 个交易日</span>'
        f'<span>最低 <b>{lo["c"]:.3f}</b>({lo["d"][5:]})</span>'
        f'<span>最高 <b>{hi["c"]:.3f}</b>({hi["d"][5:]})</span>'
        f'<span>均值 <b>{statistics.mean(cs):.3f}</b></span>'
        + (f'<span>与官方口径平均偏差 <b>{mae:.4f}</b></span>' if mae else "")
        + "</div>"
    )


def render_html(rows, div_rows, meta):
    css = _HTML_CSS
    last = rows[-1]
    c_last = last["c"]
    views = []
    segs_def = [("v3", 63), ("v6", 126), ("v12", len(rows))]
    for cls, count in segs_def:
        view = rows[-count:] if count < len(rows) else rows
        views.append(
            f'<div class="view {cls}">'
            + _svg(view, 880, 360, 52, 62, 22, 34, 12, 7).replace('class="ch"', 'class="ch wide"')
            + _svg(view, 380, 300, 40, 30, 18, 30, 11, 4).replace('class="ch"', 'class="ch narrow"')
            + _stats_row(view)
            + "</div>"
        )

    dt_rows = "".join(
        f'<tr><td class="num">{s["d"][2:]}</td><td class="num">{s["hy"]:,}</td>'
        f'<td class="num">{s["sq"]:,}</td><td class="num">{s["c"]:.4f}</td>'
        f'<td class="num">{s["co"]:.4f}</td></tr>' if s["co"] is not None else
        f'<tr><td class="num">{s["d"][2:]}</td><td class="num">{s["hy"]:,}</td>'
        f'<td class="num">{s["sq"]:,}</td><td class="num">{s["c"]:.4f}</td>'
        f'<td class="num">—</td></tr>'
        for s in rows
    )

    def arrow(a, b):
        if a == b:
            return f'<span class="same">{a:,}</span>'
        return f'<span class="was">{a:,}</span> <span class="to">→</span> {b:,}'

    div_html = "".join(
        f'<tr><td class="num">{r[0]}</td><td class="num">{arrow(r[1], r[2])}</td>'
        f'<td class="num">{arrow(r[3], r[4])}</td></tr>'
        for r in div_rows
    )

    return string.Template(_HTML_TMPL).substitute(
        css=css,
        src=meta["source"],
        asof=last["d"],
        nav_asof=meta["nav_asof"],
        c3=f"{c_last:.3f}",
        c1=f"{c_last * 100:.1f}",
        disc=f"{(1 - c_last) * 100:.1f}",
        lev=f"{1 / c_last:.2f}",
        pay_pct=f"{min(100, c_last * 100):.1f}",
        hy=last["hy"],
        sq=last["sq"],
        hy_fmt=f"{last['hy']:,}",
        sq_fmt=f"{last['sq']:,}",
        backing=f"{K * last['hy']:,.0f}",
        k=f"{K:.6f}",
        n_hy=f"{SHARES_HYNIX_HELD:,}",
        n_sq=f"{SHARES_SKQ_ISSUED:,}",
        views="".join(views),
        dt_rows=dt_rows,
        n_rows=len(rows),
        div_rows=div_html,
        n_div=len(div_rows),
        n_same=meta["n_total"] - len(div_rows),
        n_total=meta["n_total"],
        calib=meta["calib"],
        other=f"{meta['other_krw'] / 1e12:.2f}",
        built=meta["built"],
    )


# --- 入口 -------------------------------------------------------------------
def build_parser():
    p = argparse.ArgumentParser(
        prog="sk-discount",
        description="SK스퀘어 相对其 SK하이닉스 持仓的折价追踪器。不带子命令时输出当前读数。",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="示例:\n"
               "  sk-discount                      当前折价\n"
               "  sk-discount --precise            计入非海力士资产\n"
               "  sk-discount --hynix 1857000 --skq 1079000\n"
               "  sk-discount history -p 6m --official\n"
               "  sk-discount history --csv > c.csv\n"
               "  sk-discount calibrate            校验内置持股数\n",
    )
    # 全局开关放在主解析器上给出默认值;子解析器上再挂一份同名开关,
    # 好让它们写在子命令之后也生效。子解析器那份必须 default=SUPPRESS,
    # 否则它的默认值会把主解析器已经设好的值覆盖掉。
    def add_global(q, primary):
        kw = {} if primary else {"default": argparse.SUPPRESS}
        q.add_argument("--json", action="store_true",
                       help="以 JSON 输出" if primary else argparse.SUPPRESS, **kw)
        q.add_argument("--no-color", action="store_true",
                       help="禁用彩色输出" if primary else argparse.SUPPRESS, **kw)

    def add_now(q, primary):
        kw = {} if primary else {"default": argparse.SUPPRESS}
        hide = (lambda t: t if primary else argparse.SUPPRESS)
        q.add_argument("--hynix", type=float, metavar="₩", help=hide("手动指定海力士股价"), **kw)
        q.add_argument("--skq", type=float, metavar="₩", help=hide("手动指定 SK Square 股价"), **kw)
        q.add_argument("--precise", action="store_true",
                       help=hide("计入非海力士资产(需联网取官网 NAV)"), **kw)

    add_global(p, True)
    add_now(p, True)
    sub = p.add_subparsers(dest="cmd")

    n = sub.add_parser("now", help="当前折价读数")
    add_now(n, False)
    add_global(n, False)

    h = sub.add_parser("history", help="历史序列 + 走势图")
    h.add_argument("-p", "--period", choices=list(PERIODS), default="3m", help="区间,默认 3m")
    h.add_argument("--official", action="store_true", help="附官网日频 NAV 折价做对照")
    h.add_argument("--tail", type=int, default=15, metavar="N", help="只显示最后 N 行,默认 15")
    h.add_argument("--all", action="store_true", help="显示全部行")
    h.add_argument("--csv", action="store_true", help="输出 CSV")
    add_global(h, False)

    c = sub.add_parser("calibrate", help="用官网 NAV 折价反解并校验内置持股数")
    c.add_argument("-p", "--period", choices=list(PERIODS), default="6m", help="标定区间,默认 6m")
    add_global(c, False)

    w = sub.add_parser("html", help="生成离线单文件网页(无需 JavaScript 即可阅读)")
    w.add_argument("-o", "--out", default="sk-discount.html", metavar="FILE", help="输出路径")
    w.add_argument("--source", choices=["alphasquare", "yahoo"], default="alphasquare",
                   help="行情源,默认 alphasquare")
    add_global(w, False)

    s = sub.add_parser("params", help="显示结构参数、公式与数据源")
    add_global(s, False)
    return p


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    color = sys.stdout.isatty() and not args.no_color and not os.environ.get("NO_COLOR")
    f = Fmt(color)
    handlers = {None: cmd_now, "now": cmd_now, "history": cmd_history,
                "calibrate": cmd_calibrate, "params": cmd_params, "html": cmd_html}
    try:
        handlers[args.cmd](args, f)
    except DataError as e:
        print(f"sk-discount: {e}", file=sys.stderr)
        return 2
    except KeyboardInterrupt:
        return 130
    return 0


if __name__ == "__main__":
    sys.exit(main())
