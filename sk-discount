# --- 结构参数 ---------------------------------------------------------------
# SK Square 持有的 SK 海力士股数。来源:DART/KRX 披露的「SK스퀘어 외 9인」
# 持股 146,128,233 股 = 海力士总发行股数 730,492,365 股的 20.00%。
# 用 SK Square 官网日频 NAV 折价反解可独立验证(见 `calibrate` 子命令)。
SHARES_HYNIX_HELD = 146_128_233

# SK Square 自身总发行股数。来源:SK Square IR「Number of Stocks Issued」。
SHARES_SKQ_ISSUED = 131_923_998

K = SHARES_HYNIX_HELD / SHARES_SKQ_ISSUED

# 海力士以外的资产(TMAP / SK shieldus / SK planet / wavve / 其他 / 净现金)。
# 仅 --precise 模式使用;能连上官网时以官网实时数值覆盖此兜底值。
OTHER_ASSETS_KRW_FALLBACK = 4.86e12

HYNIX = ("000660.KS", "SK하이닉스")
SKQ = ("402340.KS", "SK스퀘어")

YAHOO = "https://query1.finance.yahoo.com/v8/finance/chart/{sym}?range={rng}&interval=1d"
NAV_URL = "https://www.sksquare.com/eng/ir/nav.do"
UA = "Mozilla/5.0 (compatible; sk-discount/1.0)"

# AlphaSquare 的行情接口按内部 stock_id 取数,不接受股票代码。
ALPHA_API = "https://api.alphasquare.co.kr"
ALPHA_IDS = {"000660": 1456, "402340": 3493}

PERIODS = {"3m": "3mo", "6m": "6mo", "1y": "1y", "2y": "2y", "5y": "5y"}


class DataError(RuntimeError):
    pass


# --- 取数 -------------------------------------------------------------------
def fetch(url, timeout=20):
    req = urllib.request.Request(url, headers={"User-Agent": UA, "Accept": "*/*"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return r.read()
    except urllib.error.HTTPError as e:
        raise DataError(f"{url} 返回 HTTP {e.code}") from e
    except (urllib.error.URLError, TimeoutError, OSError) as e:
        raise DataError(f"无法访问 {url}:{e}") from e


def quote(sym, rng="3mo"):
    """返回 (日收盘序列 {YYYY-MM-DD: 价格}, 最新价, 最新价时间戳)。"""
    raw = json.loads(fetch(YAHOO.format(sym=sym, rng=rng)))
    res = (raw.get("chart") or {}).get("result")
    if not res:
        err = ((raw.get("chart") or {}).get("error") or {}).get("description", "无数据")
        raise DataError(f"{sym}:{err}")
    node = res[0]
    meta = node.get("meta") or {}
    closes = {}
    stamps = node.get("timestamp") or []
    vals = ((node.get("indicators") or {}).get("quote") or [{}])[0].get("close") or []
    for ts, px in zip(stamps, vals):
        if px is None:
            continue
        # KST(UTC+9)下的自然日
        day = dt.datetime.utcfromtimestamp(ts + 9 * 3600).strftime("%Y-%m-%d")
        closes[day] = round(px)
    last = meta.get("regularMarketPrice")
    if last is None and closes:
        last = closes[max(closes)]
    if last is None:
        raise DataError(f"{sym}:未取到价格")
    at = meta.get("regularMarketTime")
    at = dt.datetime.utcfromtimestamp(at + 9 * 3600).strftime("%Y-%m-%d %H:%M KST") if at else "—"
    return closes, round(last), at


def alpha_series(code):
    """AlphaSquare 日线收盘价 {YYYY-MM-DD: 价格}。"""
    sid = ALPHA_IDS[code]
    url = f"{ALPHA_API}/data/v3/prices/candles/{sid}?freq=day"
    raw = json.loads(fetch(url, timeout=30))
    rows = raw.get("data") or []
    if not rows:
        raise DataError(f"AlphaSquare 未返回 {code} 的日线数据")
    out = {}
    for r in rows:
        day = dt.datetime.utcfromtimestamp(r[0] / 1000 + 9 * 3600).strftime("%Y-%m-%d")
        out[day] = int(r[4])
    return out


def nav_page():
    """解析 SK Square IR 的 NAV 页面。"""
    html = fetch(NAV_URL, timeout=30).decode("utf-8", "replace")
    series = [
        (d, float(v))
        for d, v in re.findall(r'date:\s*"(\d{4}-\d{2}-\d{2})"\s*,\s*value:\s*"([\d.]+)"', html)
    ]
    text = re.sub(r"<(script|style).*?</\1>", " ", html, flags=re.S | re.I)
    text = re.sub(r"<[^>]+>", " ", text)
    text = re.sub(r"\s+", " ", text)

    def grab(pattern, cast=float):
        m = re.search(pattern, text)
        return cast(m.group(1).replace(",", "")) if m else None

    out = {
        "asof": (re.search(r"Key Financials As of ([A-Z][a-z]{2}\.? \d{1,2}, \d{4})", text) or [None, None])[1],
        "hynix_tn": grab(r"SK hynix\s+([\d.]+)"),
        "total_tn": grab(r"Total Net Asset Value\s+([\d.]+)"),
        "shares_issued": grab(r"Number of Stocks Issued\s+([\d,]+)", int),
        "nav_per_share": grab(r"Number of Stocks Issued[^A-Z]*NAV per Share KRW ([\d,]+)", int),
        "series": series,
    }
    if out["nav_per_share"] is None:
        out["nav_per_share"] = grab(r"NAV per Share KRW ([\d,]+)", int)
    if not series or out["hynix_tn"] is None or out["total_tn"] is None:
        raise DataError("NAV 页面结构已变,解析失败")
    out["other_krw"] = (out["total_tn"] - out["hynix_tn"]) * 1e12
    return out


# --- 计算 -------------------------------------------------------------------
def cost_ratio(p_hynix, p_skq, other_krw=None):
    """c = 买 ₩1 海力士资产的成本。other_krw 非空时计入非海力士资产。"""
    backing = K * p_hynix
    if other_krw:
        backing += other_krw / SHARES_SKQ_ISSUED
    return p_skq / backing


def implied_shares(p_hynix, p_skq, discount_pct, other_krw):
    """由官方折价率反解 SK Q 持有的海力士股数。"""
    nav_per_share = p_skq / (1 - discount_pct / 100)
    return (nav_per_share * SHARES_SKQ_ISSUED - other_krw) / p_hynix


# --- 输出 -------------------------------------------------------------------
class Fmt:
    def __init__(self, on):
        self.on = on

    def __call__(self, s, code):
        return f"\033[{code}m{s}\033[0m" if self.on else str(s)

    def dim(self, s):
        return self(s, "2")

    def bold(self, s):
        return self(s, "1")

    def accent(self, s):
        return self(s, "36")

    def warn(self, s):
        return self(s, "33")


def bars(c, width, f):
    """付出 vs 得到 的对照条。"""
    width = max(12, min(width, 46))
    pay = max(1, round(width * min(c, 1.0)))
    rows = [
        ("你付出", "█" * pay + "·" * (width - pay), f"₩{c * 100:,.1f}"),
        ("你得到", "█" * width, "₩100.0"),
    ]
    out = []
    for label, bar, amt in rows:
        tint = f.accent(bar) if label == "你付出" else f.dim(bar)
        out.append(f"  {label}  {tint}  {f.bold(amt)}")
    return "\n".join(out)


SPARK = "▁▂▃▄▅▆▇█"


def sparkline(values):
    lo, hi = min(values), max(values)
    span = hi - lo or 1.0
    return "".join(SPARK[min(7, int((v - lo) / span * 7.999))] for v in values)


def term_width():
    try:
        return os.get_terminal_size().columns
    except OSError:
        return 80


